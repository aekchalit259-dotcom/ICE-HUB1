-- 3. ฆ่าทุกคนในแมพ 💀
----------------------------------------------------------------
TabCombat:CreateButton({
   Name = "ฆ่าทุกคนในแมพ 💀",
   Callback = function()
      local localPlayer = game.Players.LocalPlayer
      local knife = localPlayer.Backpack:FindFirstChild("Knife") or (localPlayer.Character and localPlayer.Character:FindFirstChild("Knife"))
      
      if knife then
         if knife.Parent == localPlayer.Backpack then
            knife.Parent = localPlayer.Character
         end
         for _, target in pairs(game.Players:GetPlayers()) do
            if target ~= localPlayer and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
               firetouchinterest(knife.Handle, target.Character.HumanoidRootPart, 0)
               firetouchinterest(knife.Handle, target.Character.HumanoidRootPart, 1)
            end
         end
      end
   end,
})

