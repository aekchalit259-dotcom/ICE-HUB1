-- 1. มองทะลุแยกบทบาท (ESP) 👀
----------------------------------------------------------------
local ESP_Enabled = false

local function CreateESP(player)
    if player == game.Players.LocalPlayer then return end
    
    local Highlight = Instance.new("Highlight")
    Highlight.Name = "MM2_ESP"
    Highlight.Parent = player.Character or player.CharacterAdded:Wait()
    Highlight.FillTransparency = 0.5
    Highlight.OutlineTransparency = 0
    
    local Billboard = Instance.new("BillboardGui")
    Billboard.Name = "MM2_ESP_Tag"
    Billboard.Size = UDim2.new(0, 100, 0, 50)
    Billboard.StudsOffset = Vector3.new(0, 3, 0)
    Billboard.AlwaysOnTop = true
    Billboard.Parent = player.Character or player.CharacterAdded:Wait()
    
    local TextLabel = Instance.new("TextLabel")
    TextLabel.Size = UDim2.new(1, 0, 1, 0)
    TextLabel.BackgroundTransparency = 1
    TextLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    TextLabel.TextScaled = true
    TextLabel.Font = Enum.Font.SourceSansBold
    TextLabel.Parent = Billboard

    task.spawn(function()
        while ESP_Enabled and player.Parent do
            if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                local isMurder = player.Backpack:FindFirstChild("Knife") or player.Character:FindFirstChild("Knife")
                local isSheriff = player.Backpack:FindFirstChild("Gun") or player.Character:FindFirstChild("Gun")
                
                if isMurder then
                    Highlight.FillColor = Color3.fromRGB(255, 0, 0)
                    TextLabel.Text = "คนไม่ดี 🔴"
                elseif isSheriff then
                    Highlight.FillColor = Color3.fromRGB(0, 150, 255)
                    TextLabel.Text = "ฮีโร่ 🔵"
                else
                    Highlight.FillColor = Color3.fromRGB(0, 255, 0)
                    TextLabel.Text = "คนดี 🟢"
                end
            end
            task.wait(1)
        end
        Highlight:Destroy()
        Billboard:Destroy()
    end)
end

TabVisuals:CreateToggle({
   Name = "มองทะลุแยกบทบาท (ESP) 👀",
   CurrentValue = false,
   Callback = function(Value)
      ESP_Enabled = Value
      if ESP_Enabled then
         for _, player in pairs(game.Players:GetPlayers()) do
            if player ~= game.Players.LocalPlayer then
               CreateESP(player)
            end
         end
      end
   end,
})

