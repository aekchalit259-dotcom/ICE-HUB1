-- 6. ฟาร์มเหรียญออโต้ (Auto Farm Coin) 🪙💰
----------------------------------------------------------------
local AutoFarm_Enabled = false

TabFarming:CreateToggle({
   Name = "ฟาร์มเหรียญออโต้ (Auto Farm Coin) 🪙💰",
   CurrentValue = false,
   Callback = function(Value)
      AutoFarm_Enabled = Value
      task.spawn(function()
         while AutoFarm_Enabled do
            local coinContainer = workspace:FindFirstChild("CoinContainer", true) or workspace:FindFirstChild("CoinServer", true)
            if coinContainer then
               for _, coin in pairs(coinContainer:GetChildren()) do
                  if AutoFarm_Enabled and coin:IsA("BasePart") and game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                     game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = coin.CFrame
                     task.wait(0.3)
                  end
               end
            end
            task.wait()
         end
      end)
   end,
})

