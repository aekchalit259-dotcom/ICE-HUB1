local Aimbot_Enabled = false

TabCombat:CreateToggle({
   Name = "เล็งเป้า Murder ออโต้ (Aimbot) 🎯",
   CurrentValue = false,
   Callback = function(Value)
      Aimbot_Enabled = Value
      task.spawn(function()
